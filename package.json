    "dayjs": "^1.11.13",
    "next": "^15.5.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.61.1",
    "react-spinners": "^0.17.0",
    "zustand": "^5.0.8"
  },
